# Copy this file to `.env` and fill in real values as needed.

# --- Generation (VLM) ---
# The system checks GROQ_API_KEY first, then OPENAI_API_KEY, then falls
# back to a deterministic, offline "ExtractiveGenerator" if neither is set
# -- so the app still runs end-to-end without any external API key
# (useful for local dev / CI / grading).

# Groq (fast + cheap; OpenAI-compatible API). Get a key at https://console.groq.com
GROQ_API_KEY=
# Vision-capable model Groq currently serves. Groq's multimodal lineup
# changes fairly often -- if you get a "model not found" error, check
# https://console.groq.com/docs/models for the current vision model name.
GROQ_VLM_MODEL=qwen/qwen3.6-27b

# OpenAI (used only if GROQ_API_KEY is not set).
OPENAI_API_KEY=
VLM_MODEL=gpt-4o

# --- Vector store ---
# Where ChromaDB persists its local, file-based index.
CHROMA_PERSIST_DIR=./chroma_store

# Where images extracted from PDFs are written to disk.
EXTRACTED_IMAGES_DIR=./extracted_images
